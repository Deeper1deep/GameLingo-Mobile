<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only network state, used for the connection status on the Home screen. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Floating translation window over other apps (granted by the user in system settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground-service notification shown while screen capture runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only asked when the user turns on speech translation; captures game audio, not the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MediaProjection foreground service (screen capture). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- In-app updates: hand the verified APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".GameLingoApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameLingo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Floating translation window; starts and stops with the capture session. -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false" />

        <!-- Lets the user align the app-window outline (app-window capture only). -->
        <service
            android:name=".overlay.WindowAlignService"
            android:exported="false" />

        <!-- Custom translation area selector, shown over the game on demand. -->
        <service
            android:name=".overlay.RegionSelectorService"
            android:exported="false" />

        <!-- Translation position editor, shown over the game on demand. -->
        <service
            android:name=".overlay.PlacementEditorService"
            android:exported="false" />

        <!-- Serves the verified update APK to the system installer only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
