<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/gamelingo_secrets.preferences_pb" />
        <exclude domain="file" path="local_ai" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/gamelingo_secrets.preferences_pb" />
        <exclude domain="file" path="local_ai" />
    </device-transfer>
</data-extraction-rules>
